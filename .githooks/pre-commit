#!/bin/sh
set -eu
current_branch="$(git symbolic-ref --short HEAD)"
case "$current_branch" in
  main|master) echo "Use a task branch before committing." >&2; exit 1 ;;
esac
command -v gitleaks >/dev/null 2>&1 || { echo "Install Gitleaks before committing." >&2; exit 1; }
exec gitleaks git --staged --redact=100 --no-banner
